# Copie para .env e preencha com os valores do seu projeto Supabase.
# Nunca commite o arquivo .env (já está no .gitignore).
#
# Uso local (Web):
#   flutter run -d chrome --dart-define-from-file=.env --web-port 8085
#
# Dashboard Supabase → Project Settings → API

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Legado (opcional — use apenas se ainda não migrou para publishable key)
# SUPABASE_ANON_KEY=

# URL pública do app (redirects OAuth / e-mail)
APP_URL=http://localhost:8085

# Google OAuth (APIs & Services → Credentials → OAuth Client ID tipo "Aplicativo da Web")
# GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# Web: false = login via Supabase OAuth (padrão, funciona sem config extra no GCP)
#       true = popup nativo Google (esconde *.supabase.co; exige origins abaixo no GCP)
GOOGLE_WEB_USE_NATIVE_SIGNIN=false
# Origins obrigatórios no GCP quando native=true:
#   http://localhost:8085
#   http://127.0.0.1:8085
#   https://SEU-DOMINIO-PRODUCAO
